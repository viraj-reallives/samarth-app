{
  "expo": {
    "name": "Shri Samarth Ramdas",
    "slug": "samarth-ramdas-400",
    "scheme": "samarthramdas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FBF6EC",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "url": "https://u.expo.dev/60ba9bee-ba3a-4730-8ed5-b647786172d7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.samarthramdas400.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Samarth Ramdas"
      }
    },
    "android": {
      "package": "in.samarthramdas400.app",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A8BC2"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A8BC2",
          "image": "./assets/landing-image.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "backgroundColor": "#4A8BC2",
            "image": "./assets/landing-image.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "backgroundColor": "#4A8BC2",
            "image": "./assets/splash-android.png",
            "imageWidth": 288,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "./plugins/withAndroidLaunchBackground",
        {
          "image": "./assets/landing-image.png"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60ba9bee-ba3a-4730-8ed5-b647786172d7"
      }
    }
  }
}