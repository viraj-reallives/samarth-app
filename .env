# Copy to .env. EXPO_PUBLIC_ variables are inlined into the JS bundle at build
# time, so put nothing secret here. Both of these are public URLs already.

# The API origin. Use the pages.dev URL while testing, the live domain in release.
EXPO_PUBLIC_API_BASE=https://www.samarthramdas400.in

# Same access key as samarth-ramdas-website/src/config/web3forms.js.
# Public by design — the website already ships it in the browser. Mail goes to
# the address verified in the Web3Forms dashboard (samarthvrati@gmail.com).
EXPO_PUBLIC_WEB3FORMS_ACCESS_KEY=7def4b37-0318-4bb9-a47a-caaabc95ce12

# Only needed if /api/* returns bare file keys (literature/x.pdf) instead of full
# URLs. Leave blank if the Worker already prepends R2_BASE, which it does today.
EXPO_PUBLIC_R2_BASE=